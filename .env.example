# On Coolify you do not need this file — set these in the resource's Environment
# Variables tab instead, and leave SERVICE_* to Coolify. Locally, copy it to .env.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SA password. Coolify generates this one itself because of the SERVICE_PASSWORD_
# prefix; locally you have to fill it in. SQL Server enforces its own policy: 8+
# characters drawn from three of {upper, lower, digit, symbol}.
#   openssl rand -base64 24
SERVICE_PASSWORD_MSSQL=

# Name of the database the migrations create.
MSSQL_DATABASE=CABlazorApp

# Developer (free, full feature set) or Premium.
MSSQL_PID=Developer

# Cap on SQL Server's buffer pool. Without it, it sizes itself against the whole host.
MSSQL_MEMORY_LIMIT_MB=1024

# The database image. The default is Azure SQL Edge, the only multi-arch SQL Server
# engine Microsoft publishes — no image of SQL Server proper has an arm64 build. On
# an x86_64 host you can use the real thing instead:
#   MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_IMAGE=mcr.microsoft.com/azure-sql-edge:1.0.7

# Point the app at a database you already run instead of the bundled one. When set,
# this replaces the connection string built from the variables above — and you can
# then drop the ca-db service.
# CONNECTION_STRING=Server=my-host,1433;Database=CABlazorApp;User Id=sa;Password=...;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Coolify fills this in with the domain you attach to the ca-app service and builds
# its proxy configuration from it. Leave it empty locally.
SERVICE_FQDN_CAAPP_8080=

# Production or Development. Development turns on detailed errors and the
# migrations end point.
ASPNETCORE_ENVIRONMENT=Production

# Hard cap on the signed-files archive. It is a RAM-backed tmpfs, not a volume, so
# it never touches the disk and is cleared on restart — see Footprint in the README.
ARCHIVE_SIZE=128m

# ---------------------------------------------------------------------------
# Local only — read by docker-compose.override.yml, ignored by Coolify
# ---------------------------------------------------------------------------

APP_BIND=127.0.0.1

# Not 5000: on macOS the AirPlay Receiver in Control Center holds *:5000 on both
# IPv4 and IPv6, so http://localhost:5000 answers 403 from AirTunes instead of the
# app. Turn it off in System Settings > General > AirDrop & Handoff if you want 5000.
APP_PORT=5080
