<AuthorizeView>
    <Authorized>
        <a href="Identity/Account/Manage" class="sm:block hidden text-gray-800 font-semibold text-md text-center py-2 px-4 m-auto mx-1 rounded-lg hover:text-[#2E76B4] duration-150">@context.User.Identity?.Name</a>
        <form method="post" action="Identity/Account/LogOut">
            <button type="submit" class="sm:block hidden border-2 border-gray-800 text-gray-800 font-semibold text-md text-center hover:bg-gray-800 m-auto py-2 px-4 mx-1 text-center rounded-lg hover:text-white duration-150">Odhlásit se</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a href="Identity/Account/Register" class="sm:block hidden border-2 border-gray-800 text-gray-800 font-semibold text-md text-center hover:bg-gray-800 m-auto py-2 px-4 mx-1 text-center rounded-lg hover:text-white duration-150">Registrovat se</a>
        <a href="Identity/Account/Login" class="sm:block hidden border-2 border-gray-800 text-gray-800 font-semibold text-md text-center hover:bg-gray-800 m-auto py-2 px-4 mx-1 text-center rounded-lg hover:text-white duration-150">Přihlásit se</a>
    </NotAuthorized>
</AuthorizeView>
