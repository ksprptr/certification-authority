@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Mvc.ViewEngines
@inject IWebHostEnvironment Environment
@inject ICompositeViewEngine Engine
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>CA | @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://kit.fontawesome.com/718d16f496.js" crossorigin="anonymous"></script>
    <script src="~/_framework/blazor.server.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />
    <environment include="Development">
        <link rel="stylesheet" href="~/Identity/css/site.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/Identity/css/site.css" asp-append-version="true" />
    </environment>
</head>
<body class="bg-gray-50" style="font-family: 'Poppins', -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen, Ubuntu, Cantarell, Fira Sans, Droid Sans, Helvetica Neue, sans-serif;">
<div>
    <div>
        <nav class="bg-gray-50">
            <div class="container xl:px-32 px-6 mx-auto">
                <div class="flex justify-between py-2 text-center items-center">
                    <div class="md:block hidden"><h3 class="text-lg text-gray-700 font-medium uppercase"><a href="/">Certifikační Autorita</a></h3></div>
                    <div class="md:hidden block text-2xl">
                        <button id="btnClosed"><i class="fa-solid fa-bars"></i></button>
                        <button id="btnOpen" class="hidden"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                    <form method="post" action="/Identity/Account/LogOut">
                        <button type="submit" class="text-sky-500 font-medium text-center py-2 px-4 border-2 border-sky-500 rounded-lg hover:bg-sky-500 hover:text-white duration-150 hover:shadow-lg hover:shadow-sky-500/30">Odhlásit se</button>
                    </form>
                </div>
                <ul class="block mb-3 lg:hidden hidden" id="nav">
                    <li class="text-gray-700 font-medium rounded-lg hover:text-sky-500 duration-150"><a href="~/">Domů</a></li>
                    <hr />
                    <li class="text-gray-700 font-medium rounded-lg hover:text-sky-500 duration-150"><a asp-page="./Index">Profil</a></li>
                    <li class="text-gray-700 font-medium rounded-lg hover:text-sky-500 duration-150"><a asp-page="./Email">Email</a></li>
                    <li class="text-gray-700 font-medium rounded-lg hover:text-sky-500 duration-150"><a asp-page="./ChangePassword">Změna hesla</a></li>
                    <li class="text-gray-700 font-medium rounded-lg hover:text-sky-500 duration-150"><a asp-page="./DeletePersonalData">Smazat účet</a></li>
                </ul>
            </div> 
        </nav>
    </div>
</div>
<div class="md:flex block justify-center sm:justify-left justify-center bg-gray-100 items-start gap-x-6 pt-24 pb-72">
    <div class="md:block hidden lg:w-80 md:w-48">
        <div class="bg-gray-50 p-8 rounded-lg shadow">
            <ul class="flex-column">
                <li class="text-lg text-gray-700 hover:text-gray-800"><a asp-page="./Index">Profil</a></li>
                <li class="pt-4 text-lg text-gray-700 hover:text-gray-800"><a asp-page="./Email">Email</a></li>
                <li class="pt-4 text-lg text-gray-700 hover:text-gray-800"><a asp-page="./ChangePassword">Změna hesla</a></li>
                <li class="pt-4 text-lg text-gray-700 hover:text-gray-800"><a asp-page="./DeletePersonalData">Smazat účet</a></li>
            </ul>
        </div>
    </div>
    <div>
        @RenderBody()
    </div>
</div>

<div class="bg-gray-50">
    <div class="container xl:px-32 px-6 mx-auto">
        <div class="text-center py-4">
            <h3 class="text-gray-700 text-lg">Vytvořeno s ☕ v Hradci Králové</h3>
        </div>
    </div>
</div>

<environment include="Development">
    <script src="~/Identity/lib/jquery/dist/jquery.js"></script>
    <script src="~/Identity/js/site.js" asp-append-version="true"></script>
</environment>
<environment exclude="Development">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"
            asp-fallback-src="~/Identity/lib/jquery/dist/jquery.min.js"
            asp-fallback-test="window.jQuery"
            crossorigin="anonymous"
            integrity="sha384-ZvpUoO/+PpLXR1lu4jmpXWu80pZlYUAfxl5NsBMWOEPSjUn/6Z/hRTt8+pR6L4N2">
        </script>
    <script src="~/Identity/js/site.js" asp-append-version="true"></script>
</environment>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const nav = document.querySelector("#nav");
        const btnClosed = document.querySelector("#btnClosed");
        const btnOpen = document.querySelector("#btnOpen");
        
        const open = () => {
            nav.classList.remove("hidden");
            btnClosed.classList.add("hidden");
            btnOpen.classList.remove("hidden");
        }

        const hide = () => {
            nav.classList.add("hidden");
            btnClosed.classList.remove("hidden");
            btnOpen.classList.add("hidden");
        }

        btnClosed.addEventListener("click", open);
        btnOpen.addEventListener("click", hide);
        document.addEventListener("click", function(event) {
            if (!btnClosed.contains(event.target) && !nav.contains(event.target)) {
              hide();
            }
        });
    })
</script>