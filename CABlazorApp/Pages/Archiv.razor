@page "/archiv"
@using CABlazorApp.Pages.Shared
@inject AuthenticationStateProvider GetAuthenticationStateAsync
@inject IWebHostEnvironment Environment
@inject IJSRuntime JsRuntime

<PageTitle>CA | Archiv</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="bg-gray-100">
            <div class="container xl:px-32 px-6 mx-auto">
                <div class="flex-wrap justify-center items-center py-24">
                    <div class="bg-gray-50 rounded-lg p-8 shadow">
                        <div class="hidden">
                            @LoadFiles()
                        </div>
                        <div class="sm:flex block justify-between">
                            <h1 class="text-gray-700 text-2xl font-medium outline-none pb-2 uppercase">Soubory</h1>
                        </div>
                        <hr />
                        <div class="flex md:justify-start justify-center flex-wrap gap-x-4 gap-y-4 pt-2">
                            @if (_files.Count != 0)
                            {
                                foreach (var file in _files)
                                {
                                    Thread.Sleep(1);
                                    <div class="bg-gray-100 flex flex-col p-4 rounded-lg sm:w-[16rem]">
                                        <div class="flex justify-between items-center">
                                            <div class="flex justify-between items-center">
                                                <img src="/images/File.png" class="w-20 h-auto" alt="Soubor">
                                            </div>
                                            <div class="text-right">
                                                <h2 class="text-gray-600">Název: <span class="font-medium">@file.Item1</span></h2>
                                                <h2 class="text-gray-600">Velikost: <span class="font-medium">@file.Item2 B</span></h2>
                                            </div>
                                        </div>
                                        <div class="flex gap-x-2 items-center pt-4">
                                            <button class="w-full text-white font-medium border-2 border-sky-500 hover:border-sky-600 text-center py-2 px-6 rounded-lg bg-sky-500 hover:bg-sky-600 hover:text-white duration-150 shadow-lg shadow-sky-500/30 hover:shadow-sky-600/30" onclick="@(() => Download(file.Item1, true))">Stáhnout</button>
                                            <button class="text-xl text-red-500 border-2 border-red-500 hover:text-white font-medium text-center py-1.5 px-3.5 rounded-lg hover:bg-red-500 duration-150 shadow-lg shadow-red-500/30 hover:shadow-red-600/30" onclick="@(() => Delete(file, true))"><i class="fa-solid fa-xmark"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        @if(_files.Count == 0) { <span class="text-gray-600">Nemáte uložený žádný soubor v archívu.</span> }
                    </div>
                    <div class="bg-gray-50 rounded-lg p-8 mt-4 shadow">
                        <div class="hidden">
                            @LoadCertificates()
                        </div>
                        <div class="sm:flex block justify-between">
                            <h1 class="text-gray-700 text-2xl font-medium outline-none pb-2 uppercase">Certifikáty</h1>
                        </div>
                        <hr />
                        <div class="flex md:justify-start justify-center flex-wrap gap-x-4 gap-y-4 pt-2">
                            @if (_certificates.Count != 0)
                            {
                                foreach (var certificate in _certificates)
                                {
                                    Thread.Sleep(1);
                                    <div class="bg-gray-100 flex flex-col p-4 rounded-lg sm:w-[16rem]">
                                        <div class="flex justify-between items-center">
                                            <div class="flex justify-between items-center">
                                                <img src="/images/Certificate.png" class="w-20 h-auto" alt="Soubor">
                                            </div>
                                            <div class="text-right">
                                                <h2 class="text-gray-600">Název: <span class="font-medium">@certificate.Item1</span></h2>
                                                <h2 class="text-gray-600">Velikost: <span class="font-medium">@certificate.Item2 B</span></h2>
                                            </div>
                                        </div>
                                        <div class="flex gap-x-2 items-center pt-4">
                                            <button class="w-full text-white font-medium border-2 border-sky-500 hover:border-sky-600 text-center py-2 px-6 rounded-lg bg-sky-500 hover:bg-sky-600 hover:text-white duration-150 shadow-lg shadow-sky-500/30 hover:shadow-sky-600/30" onclick="@(() => Download(certificate.Item1, false))">Stáhnout</button>
                                            <button class="text-xl text-red-500 border-2 border-red-500 hover:text-white font-medium text-center py-1.5 px-3.5 rounded-lg hover:bg-red-500 duration-150 shadow-lg shadow-red-500/30 hover:shadow-red-600/30" onclick="@(() => Delete(certificate, false))"><i class="fa-solid fa-xmark"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        @if(_certificates.Count == 0) { <span class="text-gray-600">Nemáte uložený žádný certifikát v archívu.</span> }
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <NotSigned />
    </NotAuthorized>
</AuthorizeView>