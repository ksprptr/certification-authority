@page "/generate"
@using CABlazorApp.Pages.Shared
@inject IWebHostEnvironment Environment
@inject AuthenticationStateProvider GetAuthenticationStateAsync

<PageTitle>CA | Generovat</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <NotSigned />
    </NotAuthorized>
    <Authorized>
        <div class="bg-[#F3F3F5]">
            <div class="container xl:px-32 px-6 mx-auto">
                <div class="lg:flex block gap-y-4 xl:gap-x-4 gap-x-0 flex-wrap justify-center items-center py-24">
                    <div class="bg-[#FFFFFF] rounded-xl p-8">
                        <h1 class="sm:text-3xl text-2xl text-gray-800 font-semibold uppercase">Šifrování dokumentu</h1>
                        <form method="post" asp-action="Encrypt" enctype="multipart/form-data" asp-controller="Api" action="/api/encrypt">
                            <p class="md:w-[32rem] font-medium text-gray-600 py-1 break-words mb-4">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                            <hr />
                            <div class="block">
                                <div class="flex flex-col py-4">
                                    <label class="text-gray-800 font-semibold text-xl">Vyberte certifikát</label>
                                    <input type="file" id="CertEncryptInput" name="CertEncryptInput" @bind-value="FileEncryptInput" placeholder="Není vybrán certifikát" accept=".crt,.cer,.ca-bundle,.p7b,.p7c,p7s,.pem,.p12,.pfx" class="mt-2 file:bg-transparent file:text-gray-800 hover:cursor-pointer file:hover:cursor-pointer file:font-semibold file:text-md file:py-1 file:border-2 file:border-gray-800 file:px-2 file:rounded-lg file:hover:bg-gray-800 file:hover:text-white file:duration-150 file:box-shadow" required/>
                                </div>
                                <hr />
                                <div class="flex flex-col py-4">
                                    <label class="text-gray-800 font-semibold text-xl">Zadejte heslo</label>
                                    <input type="password" id="PasswordEncryptInput" name="PasswordEncryptInput" class="mt-2 md:w-64 w-full py-1 px-2 autofill:text-md autofill:bg-transparent text-md border-2 border-gray-800 rounded-lg bg-transparent box-shadow font-semibold" required/>
                                </div>
                                <hr />
                                <div class="flex flex-col py-4">
                                    <label class="text-gray-800 font-semibold text-xl">Vyberte dokument</label>
                                    <input type="file" id="FileEncryptInput" name="FileEncryptInput" class="mt-2 file:bg-transparent file:text-gray-800 hover:cursor-pointer file:hover:cursor-pointer file:font-semibold file:text-md file:py-1 file:border-2 file:border-gray-800 file:px-2 file:rounded-lg file:hover:bg-gray-800 file:hover:text-white file:duration-150 file:box-shadow" required/>
                                </div>
                            </div>
                            <hr/>
                            <input type="submit" class="mt-4 text-white font-semibold text-md text-center py-2 px-4 rounded-lg bg-[#2E76B4] hover:bg-[#255e90] duration-150 box-shadow hover:cursor-pointer" value="Šifrovat"/>
                        </form>
                    </div>
                    <div class="bg-[#FFFFFF] rounded-xl p-8 lg:mt-0 mt-6">
                        <h1 class="sm:text-3xl text-2xl text-gray-800 font-semibold uppercase">Dešifrování dokumentu</h1>
                        <form method="post" asp-action="Encrypt" enctype="multipart/form-data" asp-controller="Api" action="/api/encrypt">
                            <p class="md:w-[32rem] font-medium text-gray-600 py-1 break-words mb-4">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                            <hr />
                            <div class="block">
                                <div class="flex flex-col py-4">
                                    <label class="text-gray-800 font-semibold text-xl">Vyberte certifikát</label>
                                    <input type="file" id="CertDecryptInput" name="CertEncryptInput" enctype="multipart/form-data" accept=".crt,.cer,.ca-bundle,.p7b,.p7c,p7s,.pem,.p12,.pfx" class="mt-2 file:bg-transparent file:text-gray-800 hover:cursor-pointer file:hover:cursor-pointer file:font-semibold file:text-md file:py-1 file:border-2 file:border-gray-800 file:px-2 file:rounded-lg file:hover:bg-gray-800 file:hover:text-white file:duration-150 file:box-shadow" required/>
                                </div>
                                <hr />
                                <div class="flex flex-col py-4">
                                    <label class="text-gray-800 font-semibold text-xl">Zadejte heslo</label>
                                    <input type="password" id="PasswordDecryptInput" name="PasswordEncryptInput" class="mt-2 md:w-64 w-full py-1 px-2 autofill:text-md autofill:bg-transparent text-md border-2 border-gray-800 rounded-lg bg-transparent box-shadow font-semibold" required/>
                                </div>
                                <hr />
                                <div class="flex flex-col py-4">
                                    <label class="text-gray-800 font-semibold text-xl">Vyberte dokument</label>
                                    <input type="file" id="FileDecryptInput" name="FileEncryptInput" class="mt-2 file:bg-transparent file:text-gray-800 hover:cursor-pointer file:hover:cursor-pointer file:font-semibold file:text-md file:py-1 file:border-2 file:border-gray-800 file:px-2 file:rounded-lg file:hover:bg-gray-800 file:hover:text-white file:duration-150 file:box-shadow" required/>
                                </div>
                            </div>
                            <hr/>
                            <input type="submit" class="mt-4 text-white font-semibold text-md text-center py-2 px-4 rounded-lg bg-[#2E76B4] hover:bg-[#255e90] duration-150 box-shadow hover:cursor-pointer" value="Dešifrovat"/>
                        </form>
                    </div>
                    <div class="bg-[#FFFFFF] rounded-xl p-8 lg:mt-0 mt-6">
                        <h1 class="text-gray-800 sm:text-3xl text-2xl font-semibold uppercase">Generování certifikátu</h1>
                        <div class="lg:flex block justify-between">
                            <div>
                                <p class="md:w-[32rem] font-medium text-gray-600 py-1 break-words">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                                <button class="lg:mb-0 mb-4 mt-2 text-gray-800 hover:cursor-pointer font-semibold text-md py-2 border-2 border-gray-800 px-4 rounded-lg hover:bg-gray-800 hover:text-white duration-150 box-shadow">Vygenerovat</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {

    private string FileEncryptInput { get; set; }

    protected void OnInit()
    {
        FileEncryptInput = "Vyber soubor";
    }

}
