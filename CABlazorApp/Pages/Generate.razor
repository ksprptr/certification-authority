@page "/generate"
@using CABlazorApp.Pages.Shared
@using CABlazorApp.Services
@using System.IO.MemoryMappedFiles
@using System.Net
@inject CryptoService CryptoService

<PageTitle>CA | Generovat</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <NotSigned/>
    </NotAuthorized>
    <Authorized>
        <div class="bg-gray-100">
            <div class="container xl:px-32 px-6 mx-auto">
                <div class="lg:flex block gap-y-4 xl:gap-x-4 gap-x-0 flex-wrap justify-center items-center py-24">
                    <div class="bg-gray-50 rounded-lg p-8">
                        <h1 class="text-gray-700 text-2xl font-medium">Šifrování dokumentu</h1>
                        <form>
                            <p class="md:w-[32rem] text-gray-600 py-1">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                            <div class="block">
                                <div class="flex flex-col mt-4">
                                    <label class="text-gray-600 font-medium ml-0.5">Vyberte certifikát</label>
                                    <InputFile id="CertInputEnc" name="CertInputEnc" accept=".crt,.cer,.ca-bundle,.p7b,.p7c,p7s,.pem,.p12,.pfx" class="block w-full text-sm text-slate-500 file:hover:cursor-pointer file:duration-150 file:mr-2 file:py-2 file:px-4 file:rounded-lg file:border-0 file:border-sky-500 file:text-sm file:font-medium file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100"/>
                                    <span class="text-red-700 text-sm mt-1 ml-0.5">@_eMessageCertInputEnc</span>
                                </div>
                                <div class="flex flex-col mt-4">
                                    <label class="text-gray-600 font-medium ml-0.5">Zadejte heslo</label>
                                    <input type="password" id="PassInputEnc" @bind="_passInputEnc" name="PassInputEnc" placeholder="Heslo" class="placeholder:font-base focus:outline-none placeholder:text-gray-300 text-gray-600 bg-gray-50 py-2 px-3 border-2 border-gray-200 rounded-lg"/>
                                    <span class="text-red-700 text-sm mt-1 ml-0.5">@_eMessagePassInputEnc</span>
                                </div>
                                <div class="flex flex-col mt-4">
                                    <label class="text-gray-600 font-medium ml-0.5">Vyberte dokument</label>
                                    <InputFile id="FileInputEnc" name="FileInputEnc" class="block w-full text-sm text-slate-500 file:hover:cursor-pointer file:duration-150 file:mr-2 file:py-2 file:px-4 file:rounded-lg file:border-0 file:border-sky-500 file:text-sm file:font-medium file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100"/>
                                    <span class="text-red-700 text-sm mt-1 ml-0.5">@_eMessageFileInputEnc</span>
                                </div>
                            </div>
                            <button type="submit" class="mt-4 text-white font-medium text-center py-2 px-6 rounded-lg bg-sky-500 hover:bg-sky-600 hover:text-white duration-150 shadow-lg shadow-sky-500/30 hover:shadow-sky-600/30">Šifrovat</button>
                        </form>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-8 lg:mt-0 mt-6">
                        <h1 class="text-gray-700 text-2xl font-medium">Dešifrování dokumentu</h1>
                        <form>
                            <p class="md:w-[32rem] text-gray-600 py-1">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                            <div class="block">
                                <div class="flex flex-col mt-4">
                                    <label class="text-gray-600 font-medium ml-0.5">Vyberte certifikát</label>
                                    <InputFile id="CertInputDec" OnChange="OnDecryptCertFile" name="CertInputDec" accept=".crt,.cer,.ca-bundle,.p7b,.p7c,p7s,.pem,.p12,.pfx" class="block w-full text-sm text-slate-500 file:hover:cursor-pointer file:duration-150 file:mr-2 file:py-2 file:px-4 file:rounded-lg file:border-0 file:border-sky-500 file:text-sm file:font-medium file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100"/>
                                    <span class="text-red-700 text-sm mt-1 ml-0.5">@_eMessageCertInputDec</span>
                                </div>
                                <div class="flex flex-col mt-4">
                                    <label class="text-gray-600 font-medium ml-0.5">Zadejte heslo</label>
                                    <input type="password" id="PassInputDec" @bind="_decPass" placeholder="Heslo" name="PassInputDec" class="placeholder:font-base focus:outline-none placeholder:text-gray-300 text-gray-600 bg-gray-50 py-2 px-3 border-2 border-gray-200 rounded-lg"/>
                                    <span class="text-red-700 text-sm mt-1 ml-0.5">@_eMessagePassInputDec</span>
                                </div>
                                <div class="flex flex-col mt-4">
                                    <label class="text-gray-600 font-medium ml-0.5">Vyberte dokument</label>
                                    <InputFile id="FileInputDec" OnChange="OnDecryptDocumentFile" name="FileInputDec" class="block w-full text-sm text-slate-500 file:hover:cursor-pointer file:duration-150 file:mr-2 file:py-2 file:px-4 file:rounded-lg file:border-0 file:border-sky-500 file:text-sm file:font-medium file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100"/>
                                    <span class="text-red-700 text-sm mt-1 ml-0.5">@_eMessageFileInputDec</span>
                                </div>
                            </div>
                            <button @onclick="Decrypt" class="mt-4 text-white font-medium text-center py-2 px-6 rounded-lg bg-sky-500 hover:bg-sky-600 hover:text-white duration-150 shadow-lg shadow-sky-500/30 hover:shadow-sky-600/30">Dešifrovat</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {

    private byte[] _decCertFile;
    private byte[] _decDocFile;
    private string _decPass;


    private readonly string _required = "Toto pole je povinné.";

    // Encrypt variables
    private string _passInputEnc;
    private string _eMessageCertInputEnc;
    private string _eMessagePassInputEnc;
    private string _eMessageFileInputEnc;

    // Decrypt variables
    private string _certInputDec;
    private string _fileInputDec;
    private string _eMessageCertInputDec;
    private string _eMessagePassInputDec;
    private string _eMessageFileInputDec;

    // Generate variables
    private string certName;
    private string certPass;

    private async Task Decrypt()
    {
        if (_decCertFile == null || _decDocFile == null || String.IsNullOrWhiteSpace(_decPass))
        {
            if (_decCertFile == null)
            {
                _eMessageCertInputEnc = _required;
                InvokeAsync(StateHasChanged);
            }

            if (String.IsNullOrWhiteSpace(_decPass))
            {
                _eMessagePassInputEnc = _required;
                InvokeAsync(StateHasChanged);
            }

            if (_decDocFile == null)
            {
                _eMessageFileInputEnc = _required;
                InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            byte[] signedFile = await CryptoService.Sign(_decCertFile, _decDocFile, _decPass);
        }
    }


    private async Task OnDecryptDocumentFile(InputFileChangeEventArgs obj)
    {
        
        await using MemoryStream stream = new MemoryStream();
        await obj.File.OpenReadStream().CopyToAsync(stream);
        _decDocFile = stream.ToArray();
    }

    private async Task OnDecryptCertFile(InputFileChangeEventArgs obj)
    {
        await using MemoryStream stream = new MemoryStream();
        await obj.File.OpenReadStream().CopyToAsync(stream);
        _decCertFile = stream.ToArray();
    }

}