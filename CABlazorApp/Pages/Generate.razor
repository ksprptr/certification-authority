@page "/generate"

<PageTitle>CA | Generovat</PageTitle>

<div class="bg-[#F3F3F5]">
    <div class="container lg:px-36 px-6 mx-auto">
        <div class="block py-24">
            <div class="bg-[#FFFFFF] rounded-xl p-8">
                <h1 class="text-gray-800 text-3xl font-semibold uppercase">Podepsání dokumentů</h1>
                <div class="md:flex block justify-between md:text-left text-center items-center">
                   <form method="post">
                       <p class="md:w-[32rem] font-medium text-gray-600 py-1 break-words mb-4">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                       <hr />
                       <div class="flex flex-col py-4">
                           <label for="certificate" class="text-gray-800 font-semibold text-xl">Vyberte certifikát</label>
                           <div class="flex-row mt-3 mb-1">
                               <label for="certificate" class="text-gray-800 hover:cursor-pointer font-semibold text-center py-1 border-2 border-gray-800 px-2 rounded-lg hover:bg-gray-800 hover:text-white duration-150 bg-transparent">Vybrat</label>
                               <input type="file" id="certificate" class="file:hidden" required/>
                           </div>
                       </div>
                       <hr />
                       <div class="flex flex-col py-4">
                           <label class="text-gray-800 font-semibold text-xl">Vyberte dokument</label>
                           <div class="flex-row mt-3 mb-1">
                               <label for="file" class="text-gray-800 hover:cursor-pointer font-semibold text-center py-1 border-2 border-gray-800 px-2 rounded-lg hover:bg-gray-800 hover:text-white duration-150 bg-transparent">Vybrat</label>
                               <input type="file" id="file" class="file:hidden" required/>
                           </div>
                       </div>
                       <hr />
                       <input type="submit" class="mt-4 text-gray-800 hover:cursor-pointer font-semibold text-md text-center py-2 border-2 border-gray-800 px-4 rounded-lg hover:bg-gray-800 hover:text-white duration-150 box-shadow" value="Podepsat" />
                   </form>
                   <div class="flex flex-col justify-between border-2 rounded-lg border-[#2E76B4] p-4 h-[75%]">
                       <h3 class="text-gray-800 font-semibold text-lg pb-2">Zde se objeví soubor pro stažení</h3>
                       <hr />
                       <div class="flex justify-between mt-4">
                           <button class="text-[#2E76B4] hover:cursor-pointer font-semibold text-md text-center py-2 border-2 border-[#2E76B4] px-4 rounded-lg hover:bg-[#2E76B4] hover:text-white duration-150 box-shadow">Stáhnout</button>
                           <AuthorizeView>
                              <Authorized>
                                  <button class="text-[#2E76B4] hover:cursor-pointer font-semibold text-md text-center py-2 border-2 border-[#2E76B4] px-4 rounded-lg hover:bg-[#2E76B4] hover:text-white duration-150 box-shadow">Archivovat</button>
                              </Authorized>
                              <NotAuthorized>
                                  <button class="opacity-50 disabled hover:cursor-default text-[#2E76B4] font-semibold text-md text-center py-2 border-2 border-[#2E76B4] px-4 rounded-lg box-shadow">Archivovat</button>
                              </NotAuthorized>
                          </AuthorizeView>
                       </div>
                   </div>
               </div>
           </div>
           <br />
           <div class="bg-[#FFFFFF] rounded-xl p-8">
                <h1 class="text-gray-800 text-3xl font-semibold uppercase">Generování certifikátů</h1>
                <div class="md:flex block justify-between md:text-left text-center">
                   <div>
                       <p class="md:w-[32rem] font-medium text-gray-600 py-1 break-words">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Phasellus enim erat, vestibulum vel, aliquam a, posuere eu, velit. Phasellus rhoncus.</p>
                       <button class="mt-2 text-gray-800 hover:cursor-pointer font-semibold text-md text-center py-2 border-2 border-gray-800 px-4 rounded-lg hover:bg-gray-800 hover:text-white duration-150 box-shadow">Vygenerovat</button>
                   </div>
                   <div class="flex flex-col justify-between border-2 rounded-lg border-[#2E76B4] p-4 h-[75%]">
                       <h3 class="text-gray-800 font-semibold text-lg pb-2">Zde se objeví soubor pro stažení</h3>
                       <hr />
                       <div class="flex justify-between mt-4">
                           <button class="text-[#2E76B4] hover:cursor-pointer font-semibold text-md text-center py-2 border-2 border-[#2E76B4] px-4 rounded-lg hover:bg-[#2E76B4] hover:text-white duration-150 box-shadow">Stáhnout</button>
                           <AuthorizeView>
                               <Authorized>
                                   <button class="text-[#2E76B4] hover:cursor-pointer font-semibold text-md text-center py-2 border-2 border-[#2E76B4] px-4 rounded-lg hover:bg-[#2E76B4] hover:text-white duration-150 box-shadow">Archivovat</button>
                               </Authorized>
                               <NotAuthorized>
                                   <button class="opacity-50 disabled hover:cursor-default text-[#2E76B4] font-semibold text-md text-center py-2 border-2 border-[#2E76B4] px-4 rounded-lg box-shadow">Archivovat</button>
                               </NotAuthorized>
                           </AuthorizeView>
                       </div>
                   </div>
               </div>
           </div>
        </div> 
    </div>
</div>