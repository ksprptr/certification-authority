    //     var fileStream = GetFileStream();
    //
    //     using var streamRef = new DotNetStreamReference(stream: fileStream);
    //
    //     await Js.InvokeVoidAsync("downloadFileFromStream", _fileNameEnc, streamRef);
    // }

}

</Authorized>
</AuthorizeView>