<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>CA | Nenalezeno</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="bg-gray-100">
                    <div class="container xl:px-32 px-6 mx-auto">
                        <div class="text-center md:py-72 py-24">
                            <h1 class="text-gray-700 text-3xl font-medium py-1">Chyba 404</h1>
                            <p class="mx-auto text-gray-600 mb-4 py-1 text-lg">Tato stránka nebyla nalezena!</p>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>