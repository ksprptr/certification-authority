<div>
    <nav class="bg-gray-50">
        <div class="container xl:px-32 px-6 mx-auto">
            <div class="flex justify-between py-2 text-center items-center">
                <div class="lg:block hidden"><h3 class="text-lg text-gray-700 font-medium uppercase"><a href="/">Certifikační Autorita</a></h3></div>
                <div class="lg:hidden block text-2xl"><button @onclick="Toggle" @onblur="Hide">
                    @if (_toggled)
                    {
                        <i class="fa-solid fa-xmark"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-bars"></i>
                    }
                </button></div>
                <form method="post" action="/Identity/Account/LogOut">
                    <button type="submit" class="text-sky-500 font-medium text-center py-2 px-4 border-2 border-sky-500 rounded-lg hover:bg-sky-500 hover:text-white duration-150 hover:shadow-lg hover:shadow-sky-500/30">Odhlásit se</button>
                </form>
            </div>
            @if (_toggled)
            {
                <ul class="block mb-3">
                    <li><a href="/" class="text-gray-800 font-medium text-md m-auto rounded-lg hover:text-[#2E76B4] duration-150">Domů</a></li>
                    <li><a href="/archiv" class="text-gray-800 font-medium text-md m-auto rounded-lg hover:text-[#2E76B4] duration-150">Archív</a></li>
                    <li><a href="/generate" class="text-gray-800 font-medium text-md m-auto rounded-lg hover:text-[#2E76B4] duration-150">Generovat</a></li>
                    <li><a href="/Identity/Account/Manage" class="sm:hidden block text-gray-800 font-medium text-md m-auto rounded-lg hover:text-[#2E76B4] duration-150">Uživatelský panel</a></li>
                </ul>
            }
        </div> 
    </nav>
</div>

@code
{
    private bool _toggled;

    private void Toggle()
    {
        if (_toggled == true)
        {
            _toggled = false;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            _toggled = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private void Hide()
    {
        _toggled = false;
        InvokeAsync(StateHasChanged);
    }
}
