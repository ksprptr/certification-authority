@page
@model EmailModel
@{
    ViewData["Title"] = "Změna emailu";
}

<div class="bg-[#FFFFFF] rounded-xl lg:p-8 p-6 box-shadow sm:w-[40rem] w-auto">
    <h1 class="text-gray-800 text-3xl font-semibold uppercase pb-2">@ViewData["Title"]</h1>
    <hr />
    <form id="email-form" method="post">
        @if (Model.StatusMessage is not null)
        {
            @if (Model.StatusMessage == "Váš stávající email nelze změnit na tento nový email.")
            {
                <div class="bg-[#FECACA] mt-4 p-4 text-lg font-semibold text-[#EF4444] border-2 border-[#EF4444] rounded-xl text-left">
                    <partial name="_StatusMessage" for="StatusMessage" />
                </div>
            }
            else
            {
                <div class="bg-[#BBF7D0] mt-4 p-4 text-lg font-semibold text-[#22C55E] border-2 border-[#22C55E] rounded-xl text-left">
                    <partial name="_StatusMessage" for="StatusMessage" />
                </div>
            }
        }
        @if (Model.IsEmailConfirmed)
        {
            <div class="mt-2 flex flex-col">
                <label asp-for="Email" class="text-gray-800 font-semibold text-lg"></label>
                <div class="flex">
                    <input asp-for="Email" class="opacity-50 p-2 w-full autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" disabled/>
                    <span class="ml-2 bg-[#BBF7D0] p-2 text-lg font-semibold text-[#22C55E] border-2 border-[#22C55E] rounded-xl">Ověřeno</span>
                </div>
            </div>    
        }
        else
        {
            <div class="mt-2 flex flex-col">
                <label asp-for="Email" class="text-gray-800 font-semibold text-lg"></label>
                <div class="flex">
                    <input asp-for="Email" class="opacity-50 p-2 w-full autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" disabled/>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="ml-2 bg-[#FECACA] p-2 text-lg font-semibold text-[#EF4444] border-2 border-[#EF4444] rounded-xl">Neověřeno (Klikni)</button>
                </div>
            </div>
        }
        <div class="flex flex-col mt-4">
            <input asp-for="Input.NewEmail" placeholder="Nový email" class="p-2 autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" autocomplete="email" aria-required="true"/>
            <span asp-validation-for="Input.NewEmail" class="text-red-700"></span>
        </div>
        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="mt-4 text-gray-800 font-semibold text-md border-2 border-gray-800 text-center py-2 px-6 uppercase rounded-xl hover:bg-gray-800 hover:text-white duration-150 box-shadow">Změnit email</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

