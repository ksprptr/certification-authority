@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Změna hesla";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    ChangePasswordModel State = new ChangePasswordModel(null, null, null);
}


<div class="bg-[#F3F3F5]">
   <div class="container lg:px-36 px-6 mx-auto">
       <div class="py-48">
           @if(State.ChangeState())
           {
               <div class="w-[40%] mx-auto bg-[#BBF7D0] p-4 text-lg font-semibold text-[#22C55E] border-2 border-[#22C55E] rounded-xl">Vaše heslo bylo změněno.</div>
           }
           <div class="bg-[#FFFFFF] rounded-xl p-8 mt-4 box-shadow w-[40%] mx-auto">
               <h1 class="text-gray-800 text-3xl font-semibold uppercase pb-2">Změna hesla</h1>
               <hr />
               <form id="change-password-form" method="post">
                   @if (State.PassState())
                   {
                       <div class="bg-[#FECACA] mt-4 p-4 text-lg font-semibold text-[#EF4444] rounded-xl border-2 border-[#EF4444]">Zadal jste špatné heslo.</div>
                   }
                   <div class="flex flex-col mt-4">
                       <input asp-for="Input.OldPassword" placeholder="Momentální heslo" class="p-2 autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" autocomplete="current-password" aria-required="true"/>
                       <span asp-validation-for="Input.OldPassword" class="text-danger text-red-700"></span>
                   </div>
                   <div class="flex flex-col mt-4">
                       <input asp-for="Input.NewPassword" placeholder="Nové heslo" class="p-2 autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" autocomplete="new-password" aria-required="true"/>
                       <span asp-validation-for="Input.NewPassword" class="text-danger text-red-700"></span>
                   </div>
                   <div class="flex flex-col mt-4">
                       <input asp-for="Input.ConfirmPassword" placeholder="Heslo znovu" class="p-2 autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" autocomplete="new-password" aria-required="true"/>
                       <span asp-validation-for="Input.ConfirmPassword" class="text-danger text-red-700"></span>
                   </div>
                   <button type="submit" class="mt-4 text-gray-800 font-semibold text-md border-2 border-gray-800 text-center py-2 px-6 uppercase rounded-xl hover:bg-gray-800 hover:text-white duration-150 box-shadow">Změnit heslo</button>
               </form>
           </div>
       </div>
   </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
