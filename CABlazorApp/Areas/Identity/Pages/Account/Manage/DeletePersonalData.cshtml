@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Smazat účet";
}

<div class="bg-[#FFFFFF] rounded-xl lg:p-8 p-6 box-shadow sm:w-[40rem] w-auto">
   <h1 class="text-gray-800 text-3xl font-semibold uppercase pb-2">@ViewData["Title"]</h1>
   <hr />
   <form id="delete-user" method="post">
       <p class="font-semibold text-gray-600 mt-2 text-xl">Smazáním účtu přijdete o všechna data spojené s tímto účtem! Tato akce je nevratná a data nelze obnovit!</p>
       @if (Model.RequirePassword)
       {
           <div asp-validation-summary="ModelOnly" class="bg-[#FECACA] mt-4 p-4 text-lg font-semibold text-[#EF4444] border-2 border-[#EF4444] rounded-xl"></div>
           <div class="flex flex-col mt-4">
               <input asp-for="Input.Password" placeholder="Momentální heslo" class="p-2 autofill:text-lg autofill:bg-transparent text-lg border-2 border-gray-800 rounded-xl bg-transparent box-shadow font-semibold" autocomplete="current-password" aria-required="true"/>
               <span asp-validation-for="Input.Password" class="text-red-700"></span>
           </div>
       }
       <button type="submit" class="mt-4 text-white font-semibold text-md text-center py-2 px-6 uppercase rounded-xl bg-red-700 hover:bg-red-800 hover:text-gray-300 duration-150 box-shadow">Smazat</button>
   </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
