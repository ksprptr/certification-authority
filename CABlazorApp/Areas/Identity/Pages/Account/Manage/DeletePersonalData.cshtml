@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Smazat účet";
}

<div class="bg-gray-50 rounded-lg lg:p-8 p-6 shadow sm:w-[40rem] w-auto">
   <h1 class="text-gray-700 text-2xl font-medium uppercase pb-2">@ViewData["Title"]</h1>
   <hr />
   <form id="delete-user" method="post">
       <p class="text-gray-600 mt-2">Smazáním účtu přijdete o všechna data spojené s tímto účtem! Tato akce je nevratná a data nelze obnovit!</p>
       @if (Model.RequirePassword)
       {
           <div asp-validation-summary="ModelOnly" class="bg-red-100 py-3 px-4 font-medium text-md text-red-700 border-2 border-red-200 rounded-lg"></div>
           <div class="flex flex-col mt-2">
               <label asp-for="Input.Password" class="text-gray-600 font-medium"></label>
               <input asp-for="Input.Password" placeholder="Vaše heslo" class="placeholder:font-base focus:outline-none placeholder:text-gray-300 text-gray-600 bg-gray-50 py-2 px-3 border-2 border-gray-200 rounded-lg" autocomplete="current-password" aria-required="true"/>
               <span asp-validation-for="Input.Password" class="text-red-700 text-sm mt-1 ml-0.5"></span>
           </div>
       }
       <button type="submit" class="mt-2 text-white font-medium text-center py-2 px-6 rounded-lg bg-red-500 hover:bg-red-600 hover:text-white duration-150 shadow-lg shadow-red-500/30 hover:shadow-red-600/30">Smazat</button>
   </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
