@page
@model LoginModel

@{
    ViewData["Title"] = "Přihlásit se";
    Layout = "_IdentityEmptyLayout";
}

<div class="container xl:px-32 px-6 mx-auto">
    <div class="xl:w-[25%] lg:w-[50%] md:w-[75%] sm:w-auto mx-auto md:mt-52 mt-32 bg-gray-50 rounded-lg p-8 shadow">
        <h2 class="text-gray-700 text-2xl font-medium uppercase pb-2 text-center">@ViewData["Title"]</h2>
        <hr />
        <form id="account" method="post">
            <div class="flex flex-col justify-center mx-auto">
                <div asp-validation-summary="ModelOnly" class="mt-4 font-medium mx-auto bg-red-100 py-3 px-4 text-red-700 border-2 border-red-200 rounded-lg"></div>
                <div class="flex flex-col justify-center mt-2">
                    <label asp-for="Input.Email" class="text-gray-600 font-medium ml-0.5"></label>
                    <input asp-for="Input.Email" placeholder="Email" class="placeholder:font-base focus:outline-none placeholder:text-gray-300 text-gray-600 bg-gray-50 py-2 px-3 border-2 border-gray-200 rounded-lg" autocomplete="username" aria-required="true"/>
                    <span asp-validation-for="Input.Email" class="text-red-700 text-sm mt-1 ml-0.5"></span>
                </div>
                <div class="flex flex-col justify-center mt-2">
                    <label asp-for="Input.Password" class="text-gray-600 font-medium ml-0.5"></label>
                    <input asp-for="Input.Password" placeholder="Heslo" class="placeholder:font-base focus:outline-none placeholder:text-gray-300 text-gray-600 bg-gray-50 py-2 px-3 border-2 border-gray-200 rounded-lg" autocomplete="current-password" aria-required="true"/>
                    <span asp-validation-for="Input.Password" class="text-red-700 text-sm mt-1 ml-0.5"></span>
                </div>
                <div class="mt-2">
                    <div class="checkbox font-medium text-gray-600">
                        <label asp-for="Input.RememberMe">
                            <input class="form-check-input" asp-for="Input.RememberMe"/>
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
            </div>
            <div class="flex mt-2">
                <div class="mx-auto">
                    <button id="login-submit" type="submit" class="mt-2 text-white font-medium text-center py-2 px-6 rounded-lg bg-sky-500 hover:bg-sky-600 hover:text-white duration-150 shadow-lg shadow-sky-500/30 hover:shadow-sky-600/30">Přihlásit se</button>
                </div>
            </div>
            <div class="underline text-sm flex justify-between text-sky-600 mt-4 items-center">
                <div>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">Zapomenuté heslo</a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrovat se</a>
                    </p>
                </div>
                <div>
                    <p><a href="~/">Zpět</a></p>
                </div>
                
                <!-- <p>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                </p> -->
            </div>
        </form>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
